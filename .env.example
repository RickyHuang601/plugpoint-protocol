# Never commit a funded private key. Copy this file to .env and provide secrets locally.
PRIVATE_KEY=your_private_key_without_0x
PLATFORM_TREASURY=0x18d0c0AFf6d1d7C5fc1719308Bcb1Cb77A239917
INITIAL_TOKEN_HOLDER=0x18d0c0AFf6d1d7C5fc1719308Bcb1Cb77A239917
# BSC Mainnet official 18-decimal USDT. Leave empty on local/testnet to deploy MockUSDT.
PAYMENT_TOKEN_ADDRESS=
INITIAL_EXCHANGE_RATE=10
# Etherscan API v2 unified key, used for BSC and BSC Testnet verification.
BSCSCAN_API_KEY=your_etherscan_api_v2_key
